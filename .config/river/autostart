#!/bin/sh
set -eu

export XDG_CURRENT_DESKTOP=river
export XDG_SESSION_DESKTOP=river
export MOZ_ENABLE_WAYLAND=1
export QT_QPA_PLATFORM=wayland
export ELECTRON_OZONE_PLATFORM_HINT=auto

# Optional monitor profiles.
if command -v kanshi >/dev/null 2>&1; then
    kanshi &
fi

# Animated wallpaper. Create ~/.config/river/wallpaper with an image path.
if command -v swww >/dev/null 2>&1 && [ -f "$HOME/.config/river/wallpaper" ]; then
    wallpaper=$(cat "$HOME/.config/river/wallpaper")
    swww img "$wallpaper" --transition-type wipe --transition-duration 1
fi

# Lock after inactivity when the optional tools are installed.
if command -v swayidle >/dev/null 2>&1 && command -v swaylock >/dev/null 2>&1; then
    swayidle -w \
        timeout 600 'swaylock -f -c 1e1e2e' \
        timeout 900 'systemctl suspend' \
        before-sleep 'swaylock -f -c 1e1e2e' &
fi

# Polkit agent, if available.
if command -v /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1 >/dev/null 2>&1; then
    /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1 &
elif command -v /usr/lib/polkit-kde-authentication-agent-1 >/dev/null 2>&1; then
    /usr/lib/polkit-kde-authentication-agent-1 &
fi
