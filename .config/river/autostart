#!/bin/sh
set -eu

export XDG_CURRENT_DESKTOP=river
export XDG_SESSION_DESKTOP=river
export MOZ_ENABLE_WAYLAND=1
export QT_QPA_PLATFORM=wayland
export ELECTRON_OZONE_PLATFORM_HINT=auto

# Start a wallpaper only when one is configured in this repository.
if command -v swww >/dev/null 2>&1 && [ -f "$HOME/.config/river/wallpaper" ]; then
    swww img "$(cat "$HOME/.config/river/wallpaper")" --transition-type none
fi

# Start the polkit agent if installed.
if command -v /usr/lib/polkit-kde-authentication-agent-1 >/dev/null 2>&1; then
    /usr/lib/polkit-kde-authentication-agent-1 &
elif command -v lxqt-policykit-agent >/dev/null 2>&1; then
    lxqt-policykit-agent &
fi
